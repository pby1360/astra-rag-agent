# 이 파일을 복사해 .env 로 저장하고 실제 키를 채우세요.
#   PowerShell:  Copy-Item .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REPORT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- LlamaParse (PDF 파싱, 무료 크레딧) ---
LLAMA_CLOUD_API_KEY=llx-...

# --- Neo4j ---
# 로컬 Docker: bolt://localhost:7687
# AuraDB Free: neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=astra-rag-password
